{
    "name": "angeo/module-mcp-server",
    "description": "MCP (Model Context Protocol) server for Magento 2 — gives AI agents (Claude, Gemini, ChatGPT, custom assistants) live, structured, rate-limited access to your catalog: product search, product cards, categories, and store info. Speaks MCP 2026-07-28 (stateless) and every earlier revision. Read-only by default, no scraping required.",
    "type": "magento2-module",
    "version": "2.4.0",
    "license": "MIT",
    "keywords": [
        "magento2",
        "mcp",
        "model-context-protocol",
        "ai-agents",
        "agentic-commerce",
        "aeo",
        "llm",
        "claude",
        "chatgpt",
        "gemini",
        "ucp",
        "adobe-commerce"
    ],
    "homepage": "https://angeo.dev",
    "support": {
        "issues": "https://github.com/angeo-dev/module-mcp-server/issues",
        "email": "support@angeo.dev"
    },
    "require": {
        "php": "~8.1.0||~8.2.0||~8.3.0||~8.4.0||~8.5.0",
        "magento/framework": ">=103.0.6 <104",
        "magento/module-authorization": ">=100.4.6 <101",
        "magento/module-catalog": ">=104.0.6 <105",
        "magento/module-catalog-inventory": ">=100.4.6 <101",
        "magento/module-configurable-product": ">=100.4.6 <101",
        "magento/module-cron": ">=100.4.6 <101",
        "magento/module-customer": ">=103.0.6 <104",
        "magento/module-integration": ">=100.4.6 <101",
        "magento/module-store": ">=101.1.6 <102"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "magento/magento-coding-standard": "^40.0 || ^41.0",
        "phpstan/phpstan": "^2.0",
        "bitexpert/phpstan-magento": "^0.43"
    },
    "suggest": {
        "angeo/module-llms-txt": "Generate llms.txt discovery files that link agents to this server",
        "angeo/module-mcp-checkout": "Guest cart and checkout tools: agents take a shopper from search to a placed order",
        "angeo/module-mcp-reorder": "Signed-in customer tools: order history, reorder and quick order into the customer's own cart (B2B)",
        "angeo/module-ucp": "Publish a /.well-known/ucp profile that advertises this MCP endpoint to UCP-compliant agents"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Angeo\\McpServer\\": ""
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true,
            "magento/composer-dependency-version-audit-plugin": false,
            "mage-os/composer-dependency-version-audit-plugin": false,
            "magento/magento-composer-installer": false,
            "magento/inventory-composer-installer": false,
            "laminas/laminas-dependency-plugin": false,
            "php-http/discovery": false
        }
    }
}
