<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="customer_account_navigation">
            <block class="Magento\Customer\Block\Account\SortLink"
                   name="angeo-mcp-connections-link"
                   ifconfig="angeo_mcp/linking/enabled">
                <arguments>
                    <argument name="path" xsi:type="string">angeo_mcp/connections</argument>
                    <argument name="label" xsi:type="string" translate="true">AI assistants</argument>
                    <argument name="sortOrder" xsi:type="number">125</argument>
                </arguments>
            </block>
        </referenceBlock>
    </body>
</page>
