<?xml version="1.0"?>
<!--
    Account linking (2.4.0): a signed-in shopper lets an MCP connector act for
    them. Only SHA-256 hashes of codes and grant secrets are stored. Rows go
    with the customer account (ON DELETE CASCADE).
-->
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="angeo_mcp_link_code" resource="default" engine="innodb"
           comment="Angeo MCP: one-time account-link codes">
        <column xsi:type="varchar" name="code_hash" length="64" nullable="false" comment="SHA-256 of the code"/>
        <column xsi:type="int" name="customer_id" unsigned="true" nullable="false" comment="Customer"/>
        <column xsi:type="smallint" name="website_id" unsigned="true" nullable="false" comment="Website"/>
        <column xsi:type="varchar" name="redirect_uri" length="500" nullable="false" comment="Exact redirect URI"/>
        <column xsi:type="varchar" name="code_challenge" length="43" nullable="false" comment="PKCE S256 challenge"/>
        <column xsi:type="datetime" name="expires_at" nullable="false" comment="Expiry (UTC)"/>
        <column xsi:type="boolean" name="used" nullable="false" default="0" comment="Already exchanged"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="code_hash"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="ANGEO_MCP_LINK_CODE_CUSTOMER_ID_CUSTOMER_ENTITY_ENTITY_ID"
                    table="angeo_mcp_link_code" column="customer_id"
                    referenceTable="customer_entity" referenceColumn="entity_id" onDelete="CASCADE"/>
        <index referenceId="ANGEO_MCP_LINK_CODE_EXPIRES_AT" indexType="btree">
            <column name="expires_at"/>
        </index>
    </table>

    <table name="angeo_mcp_customer_grant" resource="default" engine="innodb"
           comment="Angeo MCP: connectors a customer allowed to act for them">
        <column xsi:type="int" name="grant_id" unsigned="true" nullable="false" identity="true" comment="Grant ID"/>
        <column xsi:type="int" name="customer_id" unsigned="true" nullable="false" comment="Customer"/>
        <column xsi:type="smallint" name="website_id" unsigned="true" nullable="false" comment="Website"/>
        <column xsi:type="int" name="consumer_id" unsigned="true" nullable="false"
                comment="Integration consumer that holds this grant"/>
        <column xsi:type="varchar" name="client_label" length="120" nullable="false" comment="Shown to the customer"/>
        <column xsi:type="varchar" name="secret_hash" length="64" nullable="false" comment="SHA-256 of the grant secret"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Created"/>
        <column xsi:type="datetime" name="last_used_at" nullable="true" comment="Last token issued (UTC)"/>
        <column xsi:type="datetime" name="revoked_at" nullable="true" comment="Revoked (UTC)"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="grant_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="ANGEO_MCP_CUSTOMER_GRANT_CUSTOMER_ID_CUSTOMER_ENTITY_ENTITY_ID"
                    table="angeo_mcp_customer_grant" column="customer_id"
                    referenceTable="customer_entity" referenceColumn="entity_id" onDelete="CASCADE"/>
        <index referenceId="ANGEO_MCP_CUSTOMER_GRANT_CUSTOMER_ID" indexType="btree">
            <column name="customer_id"/>
        </index>
    </table>
    <!--
        MCP-only customer access tokens (2.4.0). Issued to a connector for a
        grant; accepted ONLY at /mcp and ONLY together with the Integration
        token of the consumer that holds the grant. Not a Magento customer
        token: useless against REST, GraphQL or the storefront.
    -->
    <table name="angeo_mcp_access_token" resource="default" engine="innodb"
           comment="Angeo MCP: short-lived MCP-only customer tokens">
        <column xsi:type="varchar" name="token_hash" length="64" nullable="false" comment="SHA-256 of the token"/>
        <column xsi:type="int" name="grant_id" unsigned="true" nullable="false" comment="Grant"/>
        <column xsi:type="datetime" name="expires_at" nullable="false" comment="Expiry (UTC)"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="token_hash"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="ANGEO_MCP_ACCESS_TOKEN_GRANT_ID_ANGEO_MCP_CUSTOMER_GRANT"
                    table="angeo_mcp_access_token" column="grant_id"
                    referenceTable="angeo_mcp_customer_grant" referenceColumn="grant_id" onDelete="CASCADE"/>
        <index referenceId="ANGEO_MCP_ACCESS_TOKEN_EXPIRES_AT" indexType="btree">
            <column name="expires_at"/>
        </index>
    </table>
</schema>
