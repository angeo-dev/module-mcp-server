<?xml version="1.0"?>
<!-- Router MUST be registered in the frontend area scope, not global.
     Lesson from angeo/module-ucp v1.2.0: a routerList entry in global
     di.xml is silently ignored and /mcp 404s. -->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Framework\App\RouterList">
        <arguments>
            <argument name="routerList" xsi:type="array">
                <item name="angeo_mcp" xsi:type="array">
                    <item name="class" xsi:type="string">Angeo\McpServer\Controller\Router</item>
                    <item name="disable" xsi:type="boolean">false</item>
                    <item name="sortOrder" xsi:type="string">62</item>
                </item>
            </argument>
        </arguments>
    </type>
</config>
